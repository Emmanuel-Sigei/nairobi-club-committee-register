# Database
DATABASE_URL=

# Application
APP_URL=http://localhost:5173

# Zoho OAuth
# Production architecture uses refresh tokens.
# Static access-token variables remain optional transitional fallbacks.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Zoho Mail
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com/api
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_ACCESS_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM_ADDRESS=

# Zoho Calendar
ZOHO_CALENDAR_API_BASE_URL=https://calendar.zoho.com/api/v1
ZOHO_CALENDAR_REFRESH_TOKEN=
ZOHO_CALENDAR_ACCESS_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; default:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Security/session hardening
SESSION_IDLE_MINUTES=30
SESSION_TOUCH_MINUTES=5
DATABASE_URL_UNPOOLED=
EMAIL_LOGO_URL=https://images.squarespace-cdn.com/content/v1/67af2554d0698256adb3fd86/2016c344-40cb-4baa-95c9-3890b5e8c083/Nairobi-Club-logo-Gold-NoText.png
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="587"
ZOHO_SMTP_USER="superadmin@nairobiclub.com"
ZOHO_SMTP_APP_PASSWORD=
ZOHO_MAIL_FROM_NAME="Nairobi Club"
