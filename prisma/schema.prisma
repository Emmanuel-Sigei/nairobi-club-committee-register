generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
  EXCO_MANAGEMENT
}

enum CommitteeType {
  MAIN
  SUBCOMMITTEE
}

enum MembershipRole {
  CHAIR
  SECRETARY
  MEMBER
}

enum OtpPurpose {
  LOGIN
}

enum TokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum AuditActorType {
  USER
  SYSTEM
}

enum MeetingStatus {
  SCHEDULED
  CLOSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  APOLOGY
  ABSENT_NO_APOLOGY
  APOLOGY_DRAFT
  APOLOGY_DRAFT_REJECTED
}

enum AttendanceSource {
  SELF
  ADMIN
  ZOHO_SYNC
  SYSTEM
}

enum COIStatus {
  NO_CONFLICT
  CONFLICT_DECLARED
  DECLARATION_NOT_SUBMITTED
}

enum COISource {
  SELF
  ADMIN
  SYSTEM
}

enum COIRevisionKind {
  INITIAL
  CORRECTION
  SYSTEM_CLOSE
}
model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String?
  role               UserRole            @default(MEMBER)
  isActive           Boolean             @default(true)
  invitedAt          DateTime?
  passwordSetAt      DateTime?
  deactivatedAt      DateTime?
  otpLockedUntil     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        Membership[]
  sessions           Session[]
  otpChallenges      OtpChallenge[]
  oneTimeTokens      OneTimeToken[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  createdMeetings    Meeting[]           @relation("MeetingCreatedBy")
  cancelledMeetings  Meeting[]           @relation("MeetingCancelledBy")
  closedMeetings     Meeting[]           @relation("MeetingClosedBy")
  attendanceRecords  MeetingAttendance[] @relation("AttendanceUser")
  markedAttendance   MeetingAttendance[] @relation("AttendanceMarkedBy")
  conflictDeclarations MeetingConflictOfInterest[] @relation("COIUser")
  coiRevisionsCreated MeetingConflictOfInterestRevision[] @relation("COIRevisionCreatedBy")
  @@index([role])
  @@index([isActive])
}

model Committee {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  type             CommitteeType
  parentId         String?
  parent           Committee?    @relation("CommitteeHierarchy", fields: [parentId], references: [id])
  subcommittees    Committee[]   @relation("CommitteeHierarchy")
  zohoCalendarId   String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  memberships      Membership[]
  meetings         Meeting[]
  @@index([type])
  @@index([parentId])
  @@index([archivedAt])
}

model Membership {
  id               String          @id @default(cuid())
  userId           String
  committeeId      String
  role             MembershipRole  @default(MEMBER)
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  committee        Committee       @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([committeeId])
  @@index([userId, committeeId])
  @@index([committeeId, startDate])
  @@index([committeeId, endDate])
}

model Meeting {
  id               String              @id @default(cuid())
  committeeId      String
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  timezone         String              @default("Africa/Nairobi")
  location         String
  status            MeetingStatus      @default(SCHEDULED)
  zohoEventUid     String?
  lastSyncedAt     DateTime?
  lastSyncedById   String?
  closedAt         DateTime?
  closedById       String?
  cancelledAt      DateTime?
  cancelledById    String?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  committee        Committee           @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  createdBy        User                @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy      User?               @relation("MeetingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  closedBy         User?               @relation("MeetingClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  agendaItems      AgendaItem[]
  attendance       MeetingAttendance[]
  conflictDeclarations MeetingConflictOfInterest[]
  @@index([committeeId, startAt])
  @@index([status, startAt])
  @@index([zohoEventUid])
  @@index([createdById])
  @@index([lastSyncedAt])
}

model MeetingAttendance {
  id               String           @id @default(cuid())
  meetingId        String
  userId           String
  status            AttendanceStatus
  source            AttendanceSource
  reason            String?
  markedAt         DateTime         @default(now())
  markedById       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  meeting          Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user             User             @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Restrict)
  markedBy         User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  @@unique([meetingId, userId])
  @@index([meetingId, status])
  @@index([userId, markedAt])
  @@index([source])
}

model MeetingConflictOfInterest {
  id               String    @id @default(cuid())
  meetingId        String
  userId           String
  createdAt        DateTime  @default(now())
  meeting          Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user             User      @relation("COIUser", fields: [userId], references: [id], onDelete: Restrict)
  revisions        MeetingConflictOfInterestRevision[]

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model MeetingConflictOfInterestRevision {
  id               String          @id @default(cuid())
  declarationId    String
  status           COIStatus
  source           COISource
  revisionKind     COIRevisionKind
  interestTypes    String[]        @default([])
  details          String?
  agendaItemIds    String[]        @default([])
  recusalIntent    Boolean?
  correctionReason String?
  createdById      String?
  createdAt        DateTime        @default(now())
  declaration      MeetingConflictOfInterest @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  createdBy        User?           @relation("COIRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([declarationId, createdAt])
  @@index([status])
  @@index([source])
  @@index([createdById])
}
model AgendaItem {
  id               String    @id @default(cuid())
  meetingId        String
  position         Int
  title            String
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  meeting          Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  @@unique([meetingId, position])
  @@index([meetingId, position])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  tokenHash        String    @unique
  expiresAt        DateTime
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model OtpChallenge {
  id               String      @id @default(cuid())
  userId           String
  purpose          OtpPurpose  @default(LOGIN)
  codeHash         String
  expiresAt        DateTime
  attempts         Int         @default(0)
  consumedAt       DateTime?
  lastSentAt       DateTime
  lockedUntil      DateTime?
  createdAt        DateTime     @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
  @@index([consumedAt])
}

model OneTimeToken {
  id               String        @id @default(cuid())
  userId           String
  purpose          TokenPurpose
  tokenHash        String        @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
  @@index([usedAt])
}

model AuditEvent {
  id               String          @id @default(cuid())
  actorType        AuditActorType  @default(USER)
  actorUserId      String?
  action           String
  entityType       String?
  entityId         String?
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())
  actor            User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
