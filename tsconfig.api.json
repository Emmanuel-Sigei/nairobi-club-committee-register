{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "api/**/*.ts",
    "src/generated/prisma/**/*.ts"
  ]
}